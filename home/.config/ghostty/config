# Port of kitty.conf (Charcoal monochrome). kitty stays the daily driver /
# source of truth — edit there first, mirror here.
#
# Syntax diffs vs kitty: kebab-case keys, `=` assignments,
# palette = N=#hex for the 16 colors, keybind = chord=action.

# ── Font (kitty: *_font SpaceMono Nerd Font, font_size 12) ──
font-family = SpaceMono Nerd Font
font-family-bold = SpaceMono Nerd Font
font-family-italic = SpaceMono Nerd Font
font-family-bold-italic = SpaceMono Nerd Font
font-size = 12

# ── Colors: Charcoal (monochrome) ──
foreground = #d4d4d4
background = #0d0d0d
selection-foreground = #0d0d0d
selection-background = #555555

# kitty: cursor / cursor_text_color
cursor-color = #f4f4f4
cursor-text = #0d0d0d

# 16-color palette (kitty color0..color15, kept in kitty's grouped order)
# black
palette = 0=#1e1e1e
palette = 8=#333333
# red
palette = 1=#7a6a6a
palette = 9=#a09090
# green
palette = 2=#6a7a6a
palette = 10=#90a090
# yellow
palette = 3=#7a756a
palette = 11=#a09a90
# blue
palette = 4=#6a707a
palette = 12=#9098a0
# magenta
palette = 5=#756a7a
palette = 13=#9a90a0
# cyan
palette = 6=#6a787a
palette = 14=#90a0a0
# white
palette = 7=#848484
palette = 15=#d4d4d4

# ── Behavior ──
# kitty: confirm_os_window_close 0
confirm-close-surface = false
# kitty: enable_audio_bell no
bell-features = no-audio

# kitty scrollback_lines 2000 (lines) vs ghostty scrollback-limit (BYTES):
# ghostty's 10MB default dwarfs kitty's 2000 lines, so left at default.
# kitty disable_ligatures never = ligatures always on; ghostty default is on.

# ── Keys (kitty: map alt+j/k/l no_op) ──
keybind = alt+j=ignore
keybind = alt+k=ignore
keybind = alt+l=ignore

# ── Window ──
# kitty: hide_window_decorations yes (Linux, via kitty-os.conf)
gtk-titlebar = false
