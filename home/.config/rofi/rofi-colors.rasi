/* ═══════════════════════════════════════════════════════════════════════════
   ROFI COLORS — CHARCOAL (monochrome)

   This file was matugen-generated; matugen is DORMANT — nothing regenerates
   it, so values are now hardcoded to the charcoal palette (source of truth:
   ~/.config/ghostty/config). Variable names are kept so config.rasi and
   wallpaper.rasi keep working untouched.

   Tiers: #0d0d0d bg · #1e1e1e surface · #333333 raised · #555555 selection ·
   #848484 dim · #d4d4d4 fg · #f4f4f4 cursor. Whisper red #7a6a6a/#a09090 =
   error/urgent only.
   ═══════════════════════════════════════════════════════════════════════════ */

* {
    primary: #d4d4d4;
    primary-fixed: #d4d4d4;
    primary-fixed-dim: #848484;
    on-primary: #0d0d0d;
    on-primary-fixed: #0d0d0d;
    on-primary-fixed-variant: #333333;
    primary-container: #1e1e1e;
    on-primary-container: #d4d4d4;
    secondary: #848484;
    secondary-fixed: #848484;
    secondary-fixed-dim: #848484;
    on-secondary: #0d0d0d;
    on-secondary-fixed: #0d0d0d;
    on-secondary-fixed-variant: #333333;
    secondary-container: #1e1e1e;
    on-secondary-container: #d4d4d4;
    tertiary: #848484;
    tertiary-fixed: #848484;
    tertiary-fixed-dim: #848484;
    on-tertiary: #0d0d0d;
    on-tertiary-fixed: #0d0d0d;
    on-tertiary-fixed-variant: #333333;
    tertiary-container: #1e1e1e;
    on-tertiary-container: #d4d4d4;
    error: #7a6a6a;
    on-error: #0d0d0d;
    error-container: #333333;
    on-error-container: #a09090;
    surface: #0d0d0d;
    on-surface: #d4d4d4;
    on-surface-variant: #848484;
    outline: #555555;
    outline-variant: #333333;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #d4d4d4;
    inverse-on-surface: #0d0d0d;
    inverse-primary: #0d0d0d;
    surface-dim: #0d0d0d;
    surface-bright: #333333;
    surface-container-lowest: #0d0d0d;
    surface-container-low: #1e1e1e;
    surface-container: #1e1e1e;
    surface-container-high: #1e1e1e;
    surface-container-highest: #333333;

    /* override rofi's builtin solarized defaults (cream bg / lightbg) */
    background:                  #0d0d0d;
    lightbg:                     #1e1e1e;

    /* rofi element-state palette (consumed by config.rasi state refs) */
    normal-foreground:              @on-surface;
    normal-background:              rgba ( 13, 13, 13, 0 % );
    alternate-normal-foreground:    @on-surface;
    alternate-normal-background:    rgba ( 13, 13, 13, 0 % );
    active-foreground:              @on-surface;
    active-background:              @surface-container;
    urgent-foreground:              #0d0d0d;
    urgent-background:              @error;
    selected-normal-foreground:     #0d0d0d;
    selected-normal-background:     @primary;
    selected-urgent-foreground:     #0d0d0d;
    selected-urgent-background:     #a09090;
}
