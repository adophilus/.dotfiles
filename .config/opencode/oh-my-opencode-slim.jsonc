{
	"$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
	"preset": "dynamic",
	"presets": {
		"dynamic": {
			"orchestrator": {
				"model": "zai-coding-plan/glm-5.2",
				"skills": [
					"*"
				],
				"mcps": [
					"*",
					"!context7"
				]
			},
			"oracle": {
				"model": "zai-coding-plan/glm-5.2",
				"variant": "high",
				"skills": [
					"simplify"
				],
				"mcps": []
			},
			"designer": {
				"model": "zai-coding-plan/glm-5.2",
				"variant": "medium",
				"skills": [
					"agent-browser"
				],
				"mcps": []
			},
			"explorer": {
				"model": "zai-coding-plan/glm-5.2",
				"variant": "low",
				"skills": [],
				"mcps": []
			},
			"librarian": {
				"model": "zai-coding-plan/glm-5.2",
				"variant": "low",
				"skills": [],
				"mcps": [
					"websearch",
					"context7",
					"grep_app"
				]
			},
			"fixer": {
				"model": "zai-coding-plan/glm-5.2",
				"variant": "low",
				"skills": [],
				"mcps": []
			}
		},
		"opencode-go": {
			"orchestrator": {
				"model": "opencode-go/minimax-m3",
				"variant": "thinking"
			},
			"oracle": {
				"model": "opencode-go/qwen3.7-max",
				"variant": "max"
			},
			"librarian": {
				"model": "opencode-go/deepseek-v4-flash",
				"variant": "high"
			},
			"explorer": {
				"model": "opencode-go/deepseek-v4-flash",
				"variant": "high"
			},
			"designer": {
				"model": "opencode-go/kimi-k2.7-code"
			},
			"fixer": {
				"model": "opencode-go/deepseek-v4-flash",
				"variant": "high"
			},
			"observer": {
				"model": "opencode-go/mimo-v2.5"
			}
		}
	},
	"multiplexer": {
		"type": "tmux",
		"layout": "tiled",
		"main_pane_size": 60
	}
}
