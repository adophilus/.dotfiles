# Charcoal-light — luminance-mirrored charcoal.
# Each color is the charcoal counterpart with lightness inverted (HSL L' = 100% − L)
# and hue tint preserved, so red stays red-whispered and "bright" slots (9–15)
# become the darker, higher-contrast variants a light background needs.

foreground = #2b2b2b
background = #f2f2f2
selection-foreground = #f2f2f2
selection-background = #aaaaaa
cursor-color = #0b0b0b
cursor-text = #f2f2f2

# 16-color palette (kitty color0..color15, kept in kitty's grouped order)
# black
palette = 0=#e1e1e1
palette = 8=#cccccc
# red
palette = 1=#958585
palette = 9=#6f5f5f
# green
palette = 2=#859585
palette = 10=#5f6f5f
