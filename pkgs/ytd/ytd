#!/usr/bin/env bash
# ytd — YouTube downloader with simple flags
#
# Usage:
#   ytd <url>                  Download video (1080p default)
#   ytd -q 720 <url>           Set max quality (720, 480, 360, best, worst)
#   ytd -a <url>               Audio only (MP3)
#   ytd -p <url>               Playlist (numbered files)
#   ytd -a -p <url>            Playlist as audio
#   ytd -o "Custom Name" <url> Custom output name
#   ytd -s <url>               Subtitles (English, embedded)
#
# Combinations work: ytd -a -p -q best <url>

set -euo pipefail

# Defaults
QUALITY="1080"
AUDIO_ONLY=false
PLAYLIST=false
SUBTITLES=false
CUSTOM_NAME=""
THUMBNAIL=true

usage() {
    sed -n '/^# Usage/,/^# Combinations/p' "$0" | sed 's/^# \?//'
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -q|--quality)  QUALITY="$2"; shift 2 ;;
        -a|--audio)    AUDIO_ONLY=true; shift ;;
        -p|--playlist) PLAYLIST=true; shift ;;
        -s|--subs)     SUBTITLES=true; shift ;;
        -o|--output)   CUSTOM_NAME="$2"; shift 2 ;;
        -h|--help)     usage ;;
        -*)            echo "Unknown flag: $1"; usage ;;
        *)             URL="$1"; shift ;;
    esac
done

if [[ -z "${URL:-}" ]]; then
    echo "Error: no URL provided"
    usage
fi

# ── Format selector ─────────────────────────────────────────────────
# Key fix: broad fallbacks so yt-dlp always finds something.
# bv*[height<=Q]+ba/b tries separate streams first, then single file.
if [[ "${AUDIO_ONLY}" == true ]]; then
    FORMAT="ba/b"
    POST_PROCESS=(
        --extract-audio
        --audio-format mp3
        --audio-quality 0
    )
else
    if [[ "${QUALITY}" == "best" ]]; then
        FORMAT="bv*+ba/b"
    elif [[ "${QUALITY}" == "worst" ]]; then
        FORMAT="worst"
    else
        FORMAT="bv*[height<=${QUALITY}]+ba/b[height<=${QUALITY}]"
    fi
    POST_PROCESS=(--merge-output-format mp4)
fi

# ── Output template ─────────────────────────────────────────────────
if [[ -n "${CUSTOM_NAME}" ]]; then
    OUTPUT="${CUSTOM_NAME}.%(ext)s"
elif [[ "${PLAYLIST}" == true ]]; then
    # Numbered: "01 - Title.mp4" so playlist stays ordered
    OUTPUT="%(playlist_index)02d - %(title)s.%(ext)s"
else
    OUTPUT="%(title)s.%(ext)s"
fi

# ── Common args ─────────────────────────────────────────────────────
ARGS=(
    --format "${FORMAT}"
    --output "${OUTPUT}"
    --no-check-certificate
    --embed-metadata
    --restrict-filenames
)

# Thumbnail (embed in audio/video, skip for playlists to speed things up)
if [[ "${THUMBNAIL}" == true ]]; then
    ARGS+=(--embed-thumbnail)
fi

# Playlist support — don't error on playlist, download all items
if [[ "${PLAYLIST}" == true ]]; then
    ARGS+=(--yes-playlist)
else
    ARGS+=(--no-playlist)
fi

# Subtitles
if [[ "${SUBTITLES}" == true ]]; then
    ARGS+=(
        --write-subs
        --sub-langs "en.*,en"
        --embed-subs
    )
fi

ARGS+=("${POST_PROCESS[@]}")
ARGS+=("${URL}")

# ── Run ─────────────────────────────────────────────────────────────
echo "Downloading: ${URL}"
if [[ "${AUDIO_ONLY}" == true ]]; then
    echo "  Mode: Audio (MP3)"
else
    echo "  Mode: Video (${QUALITY}p max)"
fi
[[ "${PLAYLIST}" == true ]] && echo "  Playlist: Yes"
[[ "${SUBTITLES}" == true ]] && echo "  Subs: Yes"
echo ""

exec yt-dlp "${ARGS[@]}"
