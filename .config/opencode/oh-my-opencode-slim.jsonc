{
	"$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
	"preset": "dynamic",
	"presets": {
		"dynamic": {
			"orchestrator": {
				"model": "zai-coding-plan/glm-5.2",
				"skills": [
					"*"
				],
				"mcps": [
					"*",
					"!context7"
				]
			},
			"oracle": {
				"model": "zai-coding-plan/glm-5.2",
				"variant": "high",
				"skills": [
					"simplify"
				],
				"mcps": []
			},
			"designer": {
				"model": "zai-coding-plan/glm-5.2",
				"variant": "medium",
				"skills": [
					"agent-browser"
				],
				"mcps": []
			},
			"explorer": {
				"model": "zai-coding-plan/glm-5.2",
				"variant": "low",
				"skills": [],
				"mcps": []
			},
			"librarian": {
				"model": "zai-coding-plan/glm-5.2",
				"variant": "low",
				"skills": [],
				"mcps": [
					"websearch",
					"context7",
					"grep_app"
				]
			},
			"fixer": {
				"model": "zai-coding-plan/glm-5.2",
				"variant": "low",
				"skills": [],
				"mcps": []
			}
		}
	},
  "multiplexer": {
    "type": "tmux",
    "layout": "tiled",
    "main_pane_size": 60
  },
	"fallback": {
		"enabled": true,
		"timeoutMs": 15000
	}
}
