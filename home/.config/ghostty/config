# Charcoal monochrome. Ghostty is the only terminal now — palette source of
# truth lives in ./themes (charcoal, charcoal-light, mono-black, mono-white),
# applied via Ghostty's theme feature: light/dark follows the OS appearance.
#
# Syntax notes: kebab-case keys, `=` assignments, keybind = chord=action.

# ── Font ──
font-family = Monofur Nerd Font Mono
font-family-bold = Monofur Nerd Font Mono
font-family-italic = Monofur Nerd Font Mono
font-family-bold-italic = Monofur Nerd Font Mono
font-size = 20

# ── Theme ──
# Follow macOS light/dark. Pin one instead: theme = charcoal (or charcoal-light).
# Any color set in THIS file would override the theme, so none are set here.
theme = light:mono-white,dark:mono-black

# ── Behavior ──
# kitty: confirm_os_window_close 0
confirm-close-surface = false
# kitty: enable_audio_bell no
bell-features = no-audio

# kitty scrollback_lines 2000 (lines) vs ghostty scrollback-limit (BYTES):
# ghostty's 10MB default dwarfs kitty's 2000 lines, so left at default.
# kitty disable_ligatures never = ligatures always on; ghostty default is on.

# ── Keys (kitty: map alt+j/k/l no_op) ──
keybind = alt+j=ignore
keybind = alt+k=ignore
keybind = alt+l=ignore

# ── Window ──
# kitty: hide_window_decorations yes (Linux, via kitty-os.conf)
gtk-titlebar = false

# kitty runs with zero padding (its window_padding_width 4 is commented out);
# ghostty defaults to 2px. Balance centers the sub-cell grid remainder
# (window size rarely divides evenly by cell size) instead of right/bottom.
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
