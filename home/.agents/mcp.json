{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/specification/main/schemas/mcp-server-config.schema.json",
  "mcpServers": {
    "zai-mcp-server": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "@z_ai/mcp-server"
      ]
    },
    "zread": {
      "type": "http",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "web-search-prime": {
      "type": "http",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "web-reader": {
      "type": "http",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "browseros": {
      "type": "http",
      "url": "http://127.0.0.1:9000/mcp"
    },
    "pdf-reader": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "@sylphx/pdf-reader-mcp"
      ]
    },
    "penpot": {
      "type": "http",
      "url": "https://design.penpot.app/mcp/stream?userToken=${PENPOT_USER_TOKEN}"
    },
    "figma-mcp-go": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "@vkhanhqui/figma-mcp-go"
      ],
      "disabled": true
    },
    "figma-console": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "figma-console-mcp"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}",
        "ENABLE_MCP_APPS": "true"
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "tmux-mcp-rs": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "@bnomei/tmux-mcp-rs"
      ]
    },
    "open-computer-use": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "@qwen-code/open-computer-use",
        "mcp"
      ]
    }
  }
}
