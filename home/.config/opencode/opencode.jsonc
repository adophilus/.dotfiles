{
	"$schema": "https://opencode.ai/config.json",
	"plugin": [
		"opencode-antigravity-auth@1.4.6",
		"oh-my-opencode-slim@2.2.13",
		"opencode-antigravity-auth@1.6.0",
		"@dietrichgebert/ponytail@4.9.0"
	],
	"lsp": false,
	"permission": "allow",
	"mcp": {
		"zai-mcp-server": {
			"type": "local",
			"command": [
				"pnpx",
				"@z_ai/mcp-server"
			]
		},
		"zread": {
			"type": "remote",
			"url": "https://api.z.ai/api/mcp/zread/mcp",
			"headers": {
				"Authorization": "Bearer {env:Z_AI_API_KEY}"
			}
		},
		"web-search-prime": {
			"type": "remote",
			"url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
			"headers": {
				"Authorization": "Bearer {env:Z_AI_API_KEY}"
			}
		},
		"web-reader": {
			"type": "remote",
			"url": "https://api.z.ai/api/mcp/web_reader/mcp",
			"headers": {
				"Authorization": "Bearer {env:Z_AI_API_KEY}"
			}
		},
		"browseros": {
			"type": "remote",
			"url": "http://127.0.0.1:9000/mcp",
			"enabled": true
		},
		"pdf-reader": {
			"type": "local",
			"command": [
				"pnpx",
				"@sylphx/pdf-reader-mcp"
			],
			"enabled": true
		},
		"penpot": {
			"type": "remote",
			"url": "https://design.penpot.app/mcp/stream?userToken={env:PENPOT_USER_TOKEN}",
			"enabled": true
		},
		"figma-mcp-go": {
			"type": "local",
			"command": [
				"pnpx",
				"@vkhanhqui/figma-mcp-go"
			],
			"enabled": false
		},
		"figma-console": {
			"type": "local",
			"command": [
				"pnpx",
				"figma-console-mcp"
			],
			"enabled": true,
			"environment": {
				"FIGMA_ACCESS_TOKEN": "{env:FIGMA_ACCESS_TOKEN}",
				"ENABLE_MCP_APPS": "true"
			}
		},
		"codegraph": {
			"type": "local",
			"command": [
				"codegraph",
				"serve",
				"--mcp"
			],
			"enabled": true
		},
		"tmux-mcp-rs": {
			"type": "local",
			"command": [
				"pnpx",
				"@bnomei/tmux-mcp-rs"
			],
			"enabled": true
		},
		"open-computer-use": {
			"type": "local",
			"command": [
				"pnpx",
				"@qwen-code/open-computer-use",
				"mcp"
			],
			"enabled": true
		},
		"chrome-devtools": {
			"type": "local",
			"command": [
				"pnpx",
				"chrome-devtools-mcp@latest",
				"--category-extensions",
				"--executablePath",
				"/etc/profiles/per-user/adophilus/bin/google-chrome-stable"
			],
			"enabled": true
		}
		// "mitmproxy-mcp": {
		// 	"type": "local",
		// 	"command": [
		// 		"uvx",
		// 		"mitmproxy-mcp"
		// 	],
		// 	"enabled": true
		// }
	},
	"provider": {
		"google": {
			"models": {
				"antigravity-gemini-3-pro": {
					"name": "Gemini 3 Pro (Antigravity)",
					"limit": {
						"context": 1048576,
						"output": 65535
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					},
					"variants": {
						"low": {
							"thinkingLevel": "low"
						},
						"high": {
							"thinkingLevel": "high"
						}
					}
				},
				"antigravity-gemini-3.1-pro": {
					"name": "Gemini 3.1 Pro (Antigravity)",
					"limit": {
						"context": 1048576,
						"output": 65535
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					},
					"variants": {
						"low": {
							"thinkingLevel": "low"
						},
						"high": {
							"thinkingLevel": "high"
						}
					}
				},
				"antigravity-gemini-3-flash": {
					"name": "Gemini 3 Flash (Antigravity)",
					"limit": {
						"context": 1048576,
						"output": 65536
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					},
					"variants": {
						"minimal": {
							"thinkingLevel": "minimal"
						},
						"low": {
							"thinkingLevel": "low"
						},
						"medium": {
							"thinkingLevel": "medium"
						},
						"high": {
							"thinkingLevel": "high"
						}
					}
				},
				"antigravity-claude-sonnet-4-6": {
					"name": "Claude Sonnet 4.6 (Antigravity)",
					"limit": {
						"context": 200000,
						"output": 64000
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					}
				},
				"antigravity-claude-opus-4-6-thinking": {
					"name": "Claude Opus 4.6 Thinking (Antigravity)",
					"limit": {
						"context": 200000,
						"output": 64000
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					},
					"variants": {
						"low": {
							"thinkingConfig": {
								"thinkingBudget": 8192
							}
						},
						"max": {
							"thinkingConfig": {
								"thinkingBudget": 32768
							}
						}
					}
				},
				"gemini-2.5-flash": {
					"name": "Gemini 2.5 Flash (Gemini CLI)",
					"limit": {
						"context": 1048576,
						"output": 65536
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					}
				},
				"gemini-2.5-pro": {
					"name": "Gemini 2.5 Pro (Gemini CLI)",
					"limit": {
						"context": 1048576,
						"output": 65536
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					}
				},
				"gemini-3-flash-preview": {
					"name": "Gemini 3 Flash Preview (Gemini CLI)",
					"limit": {
						"context": 1048576,
						"output": 65536
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					}
				},
				"gemini-3-pro-preview": {
					"name": "Gemini 3 Pro Preview (Gemini CLI)",
					"limit": {
						"context": 1048576,
						"output": 65535
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					}
				},
				"gemini-3.1-pro-preview": {
					"name": "Gemini 3.1 Pro Preview (Gemini CLI)",
					"limit": {
						"context": 1048576,
						"output": 65535
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					}
				},
				"gemini-3.1-pro-preview-customtools": {
					"name": "Gemini 3.1 Pro Preview Custom Tools (Gemini CLI)",
					"limit": {
						"context": 1048576,
						"output": 65535
					},
					"modalities": {
						"input": [
							"text",
							"image",
							"pdf"
						],
						"output": [
							"text"
						]
					}
				}
			}
		}
		// "alibaba-model-studio": {
		// 	"npm": "@ai-sdk/openai-compatible",
		// 	"name": "Alibaba ModelStudio",
		// 	"options": {
