		// 			}
		// 		}
		// 	}
		// },
		// "chutes": {
		// 	"npm": "@ai-sdk/openai-compatible",
		// 	"name": "Chutes",
		// 	"options": {
		// 		"baseURL": "https://llm.chutes.ai/v1",
		// 		"apiKey": "{env:CHUTES_API_KEY}"
		// 	}
		// }
	},
	"agent": {
		"explore": {
			"disable": true
		},
		"general": {
			"disable": true
		}
	}
}
